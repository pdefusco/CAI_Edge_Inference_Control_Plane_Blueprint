# Local dev state: SQLite database, artifact cache, agent state, and -- the reason
# this entry is first -- the admin token and every device bearer token.
.dev/
*.token

# `.env.example` tells you to copy it to `.env` and fill in the admin token and
# the registry domain. This repo is public and that domain is a tenant
# identifier, so the copy must never be committable. `.env.example` itself is
# tracked -- the negation below is what keeps it so.
.env
.env.*
!.env.example

.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Model training leftovers (M3): checkpoints and exported artifacts are
# reproducible from the script and belong in the registry, not in git.
*.onnx
*.pt
*.pth
mlruns/
data/

.DS_Store
.idea/
.vscode/
