# Lighthouse control plane -- environment surface.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so NOTHING
# here may hold a real value. The registry domain and the app URL are tenant
# identifiers and this repo is public.
#
# Nothing in the code reads a `.env` file. These are the variables the process
# reads from its environment, written down in one place because a CAI
# Application is configured through environment variables and has no config file
# to read. In CAI you paste these into the Application's "Environment Variables"
# panel; on a laptop you `set -a; . ./.env; set +a` or let `make dev` handle it.
#
# Every name below is read in `control-plane/src/lighthouse/config.py`. Defaults
# quoted here are that file's defaults, not a second opinion about them.


# == the one switch everything else hangs off =================================

# local | cai. Three things change under `cai`, all of them deliberately:
#   * LIGHTHOUSE_ADMIN_TOKEN becomes fatal-if-missing instead of minted,
#   * LIGHTHOUSE_REGISTRY defaults to `cai` instead of `fake`,
#   * LIGHTHOUSE_DATA_DIR defaults to /home/cdsw/.lighthouse, which persists.
LIGHTHOUSE_ENV=local


# == the admin credential =====================================================

# Required when LIGHTHOUSE_ENV=cai; the process refuses to start without it. A
# CAI Application with unauthenticated access enabled has no platform auth in
# front of it, so this is the only thing between the public internet and the
# deploy/stop/revoke surface.
#
# Under `local` it is minted per run and printed, so leaving it unset there is
# fine and is what `make dev` relies on.
#
# Mint one with: python -c 'import secrets; print("lha_" + secrets.token_urlsafe(24))'
LIGHTHOUSE_ADMIN_TOKEN=


# == storage ==================================================================

# SQLite lives at <data_dir>/lighthouse.db and the artifact cache at
# <data_dir>/artifacts. In CAI this MUST be on the project filesystem
# (/home/cdsw/...) or every device enrollment is lost on the next restart --
# which is why `cai` defaults it there rather than leaving it relative.
# LIGHTHOUSE_DATA_DIR=/home/cdsw/.lighthouse

# Artifact cache ceiling, bytes. Default 8589934592 (8 GiB). Eviction is LRU and
# never touches a version a live desired deployment still references. Worth
# lowering in CAI, where the project filesystem is quota'd and this default can
# quietly consume the whole allowance.
# LIGHTHOUSE_ARTIFACT_CACHE_MAX_BYTES=2147483648

# Bytes per chunk when streaming an artifact to a device. Default 1048576.
# LIGHTHOUSE_ARTIFACT_CHUNK_SIZE=1048576

# proxy | presigned. `proxy` streams bytes through this process and is the only
# implemented transport -- and the only one that can work for a device with no
# object-store identity, which is the point of the byte proxy. `presigned` is
# accepted so a deployment setting it does not fail to boot, but nothing reads
# it: the CAI registry API offers no signed URL to forward.
# LIGHTHOUSE_ARTIFACT_TRANSPORT=proxy


# == the model registry =======================================================

# fake | cai. Defaults to `cai` under LIGHTHOUSE_ENV=cai, `fake` otherwise.
# `fake` serves a generated ONNX graph and needs none of the settings below;
# it is what the whole test suite and `make dev` run against.
# LIGHTHOUSE_REGISTRY=cai

# Exactly one of these two, never both. There is no default and never will be:
# a registry hostname identifies a tenant.
#   DOMAIN      -- the registry host, e.g. modelregistry.<workspace>.<tenant-domain>
#   ENVIRONMENT -- a CDP environment name; the domain is then discovered with
#                  `cdp ml list-model-registries` and matched to it. No
#                  "pick the first one" fallback -- that listing is tenant-wide.
# LIGHTHOUSE_REGISTRY_DOMAIN=
# LIGHTHOUSE_REGISTRY_ENVIRONMENT=

# Default /api/v2.
# LIGHTHOUSE_REGISTRY_API_PREFIX=/api/v2

# cli | env | file -- where the UMS workload JWT comes from.
#   cli  (default) shells out to `cdp iam generate-workload-auth-token`, which is
#        the auth chain a CAI Session has. The workbench API key does not work:
#        the gateway in front of the registry always 401s it.
#   env  reads LIGHTHOUSE_REGISTRY_TOKEN_ENV, which must name *another* variable
#        holding the token -- not the token itself.
#   file reads LIGHTHOUSE_REGISTRY_TOKEN_FILE.
# Both non-cli sources hand the refresh problem to whatever supplies the value.
# LIGHTHOUSE_REGISTRY_TOKEN_SOURCE=cli
# LIGHTHOUSE_REGISTRY_TOKEN_ENV=
# LIGHTHOUSE_REGISTRY_TOKEN_FILE=

# DE | DF | OPDB -- the only values `--workload-name` accepts. Default DE.
# LIGHTHOUSE_REGISTRY_WORKLOAD_NAME=DE

# Metadata calls are quick; an artifact download is not. Seconds; 30 and 900.
# LIGHTHOUSE_REGISTRY_REQUEST_TIMEOUT=30
# LIGHTHOUSE_REGISTRY_STREAM_TIMEOUT=900

# TLS. Prefer pointing at a CA bundle over turning verification off; the process
# logs a warning when it is off, and that warning is the point.
# LIGHTHOUSE_REGISTRY_VERIFY_TLS=true
# LIGHTHOUSE_REGISTRY_CA_BUNDLE=

# Seconds model metadata is cached inside the adapter. Default 30.
# Deployment-time resolution ignores it on purpose -- see ModelRegistry.get_version.
# LIGHTHOUSE_REGISTRY_CACHE_TTL=30


# == connectivity thresholds ==================================================

# How often a device is told to poll, and how its heartbeat age is classified.
# STALE must exceed ONLINE or startup fails. Seconds; 10 / 30 / 60.
# LIGHTHOUSE_HEARTBEAT_INTERVAL=10
# LIGHTHOUSE_ONLINE_THRESHOLD=30
# LIGHTHOUSE_STALE_THRESHOLD=60


# == serving ==================================================================

# NOT read by config.py -- these are read in main.py, and are listed here because
# they are the two that make an Application unreachable when wrong.
#
# CDSW_APP_PORT is set by CAI and is what the Application's public URL routes to;
# binding anything else gives an app that starts cleanly and cannot be reached.
# It wins over PORT, so leave PORT unset in CAI.
#
# PORT is the laptop and CAI-*Session* override. Inside a Session, port 8000 is
# held by something outside the user's namespace: the bind fails EADDRINUSE while
# `ss -ltn` shows nothing, and uvicorn logs "Application startup complete" before
# reporting it, so the log reads like a successful boot. Use a free high port.
# PORT=8900

# Bind address. Defaults to 127.0.0.1 under `local` and 0.0.0.0 otherwise, which
# is already right for an Application. Set it only to deliberately narrow a
# local bind.
# LIGHTHOUSE_HOST=

# Comma-separated. Empty means no cross-origin access, which is correct when the
# dashboard is served by this same process -- the normal case.
# LIGHTHOUSE_CORS_ORIGINS=

# LIGHTHOUSE_LOG_LEVEL=INFO


# == local-only test hooks ====================================================

# Corrupts one byte when serving an artifact, to prove a device refuses to
# activate on a checksum mismatch. Startup REFUSES this outside
# LIGHTHOUSE_ENV=local, so it cannot be left on by accident in CAI.
# LIGHTHOUSE_DEV_CORRUPT_ARTIFACTS=false
