# Lighthouse edge agent -- environment for the systemd unit.
#
# Installed to /etc/keeper/keeper.env as 0640 root:keeper by
# scripts/install_keeper.sh, which never overwrites an existing copy. This file is
# tracked in a PUBLIC repo, so nothing here may hold a real value: the control
# plane URL is a tenant identifier exactly as the registry domain is.
#
# systemd's EnvironmentFile syntax, which is NOT shell:
#   * no `export`, no `$VAR` expansion, no command substitution;
#   * `KEY=` sets the variable to the empty string rather than leaving it unset,
#     and `config.py` treats whitespace as unset precisely because of that;
#   * quotes are parsed and removed, so values need none unless they contain
#     spaces, and a stray trailing quote becomes part of the value.
#
# Every name below is read in edge-agent/src/keeper/config.py.


# == required ================================================================

# Must match the device_id the control plane enrolled. A mismatch is a 403 on
# every poll, which on the dashboard looks like a device that never came online.
# install_keeper.sh defaults it to the machine's hostname.
KEEPER_DEVICE_ID=

# The CAI Application's base URL, no trailing /api/v1 -- the agent appends the
# paths itself (config.url()) because the control plane returns relative artifact
# URIs. https:// in production; plain http is accepted for an on-LAN fallback and
# is the only case where KEEPER_VERIFY_TLS is worth thinking about.
KEEPER_CONTROL_PLANE_URL=

# The device bearer token, in a file. Deliberately NOT KEEPER_TOKEN: an
# environment variable is readable in /proc/<pid>/environ and is printed by
# `systemctl show keeper`, so setting it here would publish a permanent deployment
# credential to every user on the device.
#
# The file is 0640 root:keeper. Not 0600 root:root -- the unit runs as
# User=keeper, which could not read that -- and not 0644, which defeats the point.
# A wrong mode is reported as a configuration error naming the mode, not as a
# traceback; see config.py.
#
# The token arrives out of band. A device has no admin credential and therefore
# cannot enrol itself: run scripts/register_device.sh against the control plane,
# then copy the token to the device over a channel you trust.
KEEPER_TOKEN_FILE=/etc/keeper/token


# == the runtime =============================================================

# mock | onnx. `mock` reports a plausible heartbeat without doing inference; it is
# what the whole test suite and the device simulator run on. On a real device this
# must be `onnx`, and leaving it at the default is the quiet way to stand up a
# fleet that governs nothing.
#
# `onnx` refuses to start when onnxruntime is not importable (exit 2, see
# RestartPreventExitStatus in the unit). On a Jetson the wheel comes from NVIDIA's
# index rather than PyPI, which is why install_keeper.sh builds the venv with
# --system-site-packages instead of pip-installing it.
KEEPER_RUNTIME=onnx


# == optional: everything below has a working default ========================

# Defaults to /var/lib/keeper, which the unit's StateDirectory= creates and owns.
# Overriding it means also granting write access in the unit (ProtectSystem=strict
# makes everything else read-only), so prefer leaving it alone.
# KEEPER_DATA_DIR=/var/lib/keeper

# Seconds between polls of desired state. Default 10. The control plane also
# advertises an interval; this is the device's own floor.
# KEEPER_POLL_INTERVAL=10

# Seconds. An artifact download (900) and every other request (30). The control
# plane serves artifacts from a local cache, so a stall is the network or the
# ingress rather than the registry.
# KEEPER_DOWNLOAD_TIMEOUT=900
# KEEPER_REQUEST_TIMEOUT=30

# Backoff after a failed reconciliation, in seconds. A new generation resets it:
# an operator pushing a fix should not wait out a backoff earned by the previous
# instruction.
# KEEPER_RETRY_BACKOFF_INITIAL=15
# KEEPER_RETRY_BACKOFF_MAX=600

# Anything in {0,false,no,off} turns TLS verification off. The device token
# travels in that request, so this is opt-out only and the agent says so loudly.
# Point at a CA bundle instead wherever that is possible.
# KEEPER_VERIFY_TLS=true

# DEBUG logs every poll and every reconcile decision, which is what you want for
# the first hour of a new device and not afterwards.
# KEEPER_LOG_LEVEL=INFO
